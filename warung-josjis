    function selectCustomerPaymentNumber(chosenAmount, isCorrect) {
      if (!activeCustomer) return;

      if (!isCorrect) {
        SoundFX.error();
        showToast(`Nomor salah! Pilih tombol hijau sesuai total tagihan ${formatRp(activeCustomer.totalBill)}.`, 'error');
        return;
      }

      let transactionCogs = 0;
      activeCustomer.cart.forEach(item => {
        let remainToDeduct = item.qty;
        const batches = gameState.inventory[item.id].batches;
        while (remainToDeduct > 0 && batches.length > 0) {
          const b = batches[0];
          const take = Math.min(b.qty, remainToDeduct);
          transactionCogs += take * b.costPerUnit;
          b.qty -= take;
          remainToDeduct -= take;
          if (b.qty <= 0) batches.shift();
        }
      });

      gameState.businessCash += activeCustomer.totalBill;
      gameState.todayStats.revenue += activeCustomer.totalBill;
      gameState.todayStats.cogs += transactionCogs;
      gameState.todayStats.customersServed += 1;
      gameState.reputation = Math.min(5.0, +(gameState.reputation + 0.12).toFixed(2));
      gameState.energy = Math.max(10, gameState.energy - 2);

      const itemSummary = activeCustomer.cart.map(c => `${c.qty}x ${c.name}`).join(', ');
      addLog(`Terjual ke ${activeCustomer.name} (${itemSummary})`, activeCustomer.totalBill, 'in');

      spawnFloatingText(480, 290, `+${formatRp(activeCustomer.totalBill)} 🪙`, '#4ade80');
      SoundFX.coin();

      const servedCustomerName = activeCustomer.name;
      activeCustomer.state = 'leaving';
      activeCustomer.targetX = 480;
      activeCustomer.targetY = 445;
      activeCustomer = null;

      closeModal('modal-cashier');
      updateCashierBadge();
      updateAllUI();
      saveGame();
      showToast(`Pembayaran ${servedCustomerName} berhasil! Barang terjual.`, 'success');

      if (gameState.day === 1 && gameState.todayStats.customersServed === 1 && specialVisitor && specialVisitor.roleType === 'om_heri') {
        setTimeout(() => {
          startVNDialog([
            {
              speaker: 'Om Heri',
              charId: 'om_heri',
              role: 'Mentor & Tetangga Senior',
              text: `Bagus Bima! Kamu sudah paham alur jualannya: buka tanda toko, layani di kasir, pilih nomor pembayaran hijau, dan pelanggan puas keluar toko.`
            },
            {
              speaker: 'Om Heri',
              charId: 'om_heri',
              role: 'Mentor & Tetangga Senior',
              text: 'Kalau stok menipis, buka HP-mu, klik logo keranjang untuk pesan restok paket, tunggu kurir datang, lalu ambil di Ruang Restok dan isi rak satu per satu!'
            }
          ], () => {
            specialVisitor = null;
          });
        }, 450);
      }
    }

