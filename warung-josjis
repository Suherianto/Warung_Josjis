    function getSellingPrice(prodId) {
      const inv = gameState.inventory[prodId];
      const prod = PRODUCTS_MASTER.find(p => p.id === prodId);
      const baseCost = inv ? inv.todayWholesaleCost : (prod ? prod.baseWholesale : 1000);
      const mult = (inv && MARGIN_PRESETS[inv.marginKey]) ? MARGIN_PRESETS[inv.marginKey].multiplier : 1.3;
      return Math.round((baseCost * mult) / 500) * 500;
    }

