    const SoundFX = (() => {
      let ctx = null;
      let masterGain = null;
      let volume = 0.8;
      let enabled = true;
      let bgmStarted = false;

      function init() {
        if (!ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) {
            ctx = new AudioCtx();
            masterGain = ctx.createGain();
            masterGain.gain.value = enabled ? volume : 0;
            masterGain.connect(ctx.destination);
          }
        }
        if (ctx && ctx.state === 'suspended') {
          ctx.resume().catch(() => {});
        }
      }

      function tone(freq, type = 'sine', duration = 0.12, delay = 0, vol = 0.25) {
        if (!enabled || volume <= 0) return;
        init();
        if (!ctx || !masterGain) return;
        const now = ctx.currentTime + delay;
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);
        g.gain.setValueAtTime(vol, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + duration);
        osc.connect(g);
        g.connect(masterGain);
        osc.start(now);
        osc.stop(now + duration + 0.02);
      }

      function ensureBGM() {
        init();
        if (bgmStarted || !ctx) return;
        bgmStarted = true;
        const melody = [523.25, 659.25, 783.99, 659.25, 587.33, 698.46, 880.0, 698.46];
        let step = 0;
        setInterval(() => {
          if (enabled && volume > 0 && document.visibilityState === 'visible') {
            tone(melody[step % melody.length], 'triangle', 0.22, 0, 0.06);
            step++;
          }
        }, 620);
      }

      return {
        ensureBGM,
        pop: () => tone(520, 'sine', 0.08, 0, 0.18),
        coin: () => {
          tone(987.77, 'sine', 0.09, 0, 0.22);
          tone(1318.51, 'sine', 0.18, 0.08, 0.25);
        },
        buy: () => {
          tone(440, 'triangle', 0.09, 0, 0.2);
          tone(659.25, 'triangle', 0.14, 0.08, 0.22);
        },
        door: () => {
          tone(330, 'triangle', 0.12, 0, 0.18);
          tone(493.88, 'triangle', 0.15, 0.09, 0.18);
        },
        bell: () => {
          tone(1046.5, 'sine', 0.16, 0, 0.24);
          tone(1318.51, 'sine', 0.24, 0.12, 0.24);
        },
        error: () => {
          tone(220, 'sawtooth', 0.14, 0, 0.2);
          tone(175, 'sawtooth', 0.18, 0.1, 0.2);
        },
        setVolume(pct) {
          volume = Math.max(0, Math.min(1, pct / 100));
          enabled = volume > 0;
          if (masterGain && ctx) {
            masterGain.gain.setValueAtTime(enabled ? volume : 0, ctx.currentTime);
          }
        },
        getVolumePercent: () => Math.round(volume * 100),
        toggle() {
          enabled = !enabled;
          if (masterGain && ctx) {
            masterGain.gain.setValueAtTime(enabled ? volume : 0, ctx.currentTime);
          }
          return enabled;
        }
      };
    })();

