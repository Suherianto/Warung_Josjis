      const waypoints = [];
      let totalBill = 0;

      shuffled.forEach(prod => {
        const maxTake = Math.min(2, getProductTotalQty(prod.id));
        const qty = Math.max(1, Math.ceil(Math.random() * maxTake));
        const unitPrice = getSellingPrice(prod.id);
        cart.push({ id: prod.id, name: prod.name, icon: prod.icon, qty, unitPrice });
        totalBill += qty * unitPrice;

        const rack = RACK_SLOTS.find(r => r.prodId === prod.id);
        if (rack) {
          waypoints.push({ x: rack.x, y: rack.y + 34, icon: prod.icon });
        }
