    }

    function generateDailyWholesalePrices() {
      PRODUCTS_MASTER.forEach(p => {
        const inv = gameState.inventory[p.id];
        if (!inv) return;
        const factor = 0.9 + Math.random() * 0.25;
        inv.todayWholesaleCost = Math.max(500, Math.round((p.baseWholesale * factor) / 500) * 500);
