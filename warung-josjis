    function drawRoundRect(x, y, w, h, r) {
      const radius = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.arcTo(x + w, y, x + w, y + h, radius);
      ctx.arcTo(x + w, y + h, x, y + h, radius);
      ctx.arcTo(x, y + h, x, y, radius);
      ctx.arcTo(x, y, x + w, y, radius);
      ctx.closePath();
    }

    function drawCitampiTree(x, y, type = 'mango') {
      ctx.save();
      const shGrad = ctx.createRadialGradient(x + 12, y + 8, 4, x + 12, y + 8, 44);
      shGrad.addColorStop(0, 'rgba(15, 23, 42, 0.34)');
      shGrad.addColorStop(1, 'rgba(15, 23, 42, 0)');
      ctx.fillStyle = shGrad;
      ctx.beginPath();
      ctx.ellipse(x + 12, y + 8, 44, 16, 0, 0, Math.PI * 2);
      ctx.fill();

      if (type === 'banana') {
        const trunkGrad = ctx.createLinearGradient(x - 7, y, x + 7, y);
        trunkGrad.addColorStop(0, '#365314');
        trunkGrad.addColorStop(0.5, '#65a30d');
        trunkGrad.addColorStop(1, '#1a2e05');
        ctx.fillStyle = trunkGrad;
        ctx.strokeStyle = '#1a2e05';
        ctx.lineWidth = 2;
        drawRoundRect(x - 7, y - 46, 14, 48, 4);
        ctx.fill();
        ctx.stroke();

        const leafAngles = [-2.45, -1.95, -1.25, -0.45, 0.15];
        leafAngles.forEach((ang, idx) => {
          ctx.save();
          ctx.translate(x, y - 42);
          ctx.rotate(ang);
          const lGrad = ctx.createLinearGradient(0, -8, 52, 8);
          lGrad.addColorStop(0, '#4d7c0f');
          lGrad.addColorStop(0.5, idx % 2 === 0 ? '#84cc16' : '#65a30d');
          lGrad.addColorStop(1, '#3f6212');
          ctx.fillStyle = lGrad;
          ctx.beginPath();
          ctx.ellipse(28, 0, 30, 9.5, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = '#1a2e05';
          ctx.lineWidth = 1.6;
          ctx.stroke();
          ctx.strokeStyle = '#bef264';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(4, 0);
          ctx.lineTo(52, 0);
          ctx.stroke();
          ctx.restore();
        });
      } else {
        const barkGrad = ctx.createLinearGradient(x - 11, y, x + 11, y);
        barkGrad.addColorStop(0, '#451a03');
        barkGrad.addColorStop(0.45, '#92400e');
        barkGrad.addColorStop(1, '#291204');
        ctx.fillStyle = barkGrad;
        ctx.strokeStyle = '#291204';
        ctx.lineWidth = 2;
        drawRoundRect(x - 10, y - 48, 20, 50, 6);
        ctx.fill();
        ctx.stroke();

        const puffs = [
          { dx: 0, dy: -56, r: 36, c1: '#22c55e', c2: '#14532d' },
          { dx: -24, dy: -46, r: 25, c1: '#16a34a', c2: '#14532d' },
          { dx: 24, dy: -46, r: 25, c1: '#15803d', c2: '#052e16' },
          { dx: -8, dy: -68, r: 27, c1: '#4ade80', c2: '#15803d' },
          { dx: 12, dy: -62, r: 21, c1: '#86efac', c2: '#16a34a' }
        ];
        puffs.forEach(p => {
          const pGrad = ctx.createRadialGradient(x + p.dx - p.r * 0.3, y + p.dy - p.r * 0.3, 3, x + p.dx, y + p.dy, p.r);
          pGrad.addColorStop(0, p.c1);
          pGrad.addColorStop(1, p.c2);
          ctx.fillStyle = pGrad;
          ctx.beginPath();
          ctx.arc(x + p.dx, y + p.dy, p.r, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = '#14532d';
          ctx.lineWidth = 1.8;
          ctx.stroke();
        });
