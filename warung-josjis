<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Warung Josjis - Simulasi Bisnis & Literasi Keuangan</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --font-display: 'Fredoka', cursive, sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: var(--font-body);
      background-color: #1e293b;
      color: #1e293b;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
    }

    .font-rpg {
      font-family: var(--font-display);
    }

    .btn-rpg {
      position: relative;
      transition: all 0.12s cubic-bezier(0.34, 1.56, 0.64, 1);
      border-bottom-width: 4px;
      cursor: pointer;
    }
    .btn-rpg:hover:not(:disabled) {
      transform: translateY(-2px);
      filter: brightness(1.05);
    }
    .btn-rpg:active:not(:disabled) {
      transform: translateY(2px);
      border-bottom-width: 1px;
    }
    .btn-rpg:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      filter: grayscale(0.4);
    }

    #game-container {
      position: relative;
      flex: 1;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #4d7c0f;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
      touch-action: none;
    }

    .rpg-scroll::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    .rpg-scroll::-webkit-scrollbar-track {
      background: #fef3c7;
      border-radius: 999px;
    }
    .rpg-scroll::-webkit-scrollbar-thumb {
      background: #d97706;
      border-radius: 999px;
    }

    @keyframes modalPop {
      0% { transform: scale(0.92) translateY(10px); opacity: 0; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    .animate-modal {
      animation: modalPop 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes pulseBadge {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.12); }
    }
    .animate-badge {
      animation: pulseBadge 1.5s infinite;
    }

    .hud-draggable {
      touch-action: none;
      transition: box-shadow 0.15s ease;
    }
    .hud-edit-active {
      outline: 3px dashed #facc15;
      outline-offset: 4px;
      cursor: grab !important;
      background-color: rgba(250, 204, 21, 0.2);
      border-radius: 9999px;
    }
    .hud-edit-active:active {
      cursor: grabbing !important;
    }
  </style>
</head>
<body class="bg-slate-900 select-none">

  <!-- ===================================================================== -->
  <!-- LAYAR AWAL PERMAINAN (MAIN MENU: MULAI, MENU, KELUAR)                 -->
  <!-- ===================================================================== -->
  <div id="main-menu-screen" class="fixed inset-0 z-50 bg-gradient-to-b from-sky-900 via-amber-900 to-slate-950 flex flex-col items-center justify-center p-4 text-center">
    <div class="animate-modal max-w-md w-full bg-amber-50/95 border-4 border-amber-700 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6">
      <div class="space-y-2">
        <div class="inline-block bg-amber-200 border-2 border-amber-500 text-amber-950 text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full">
          Simulasi Bisnis & Literasi Keuangan Pelajar
        </div>
        <div class="text-5xl">🏪🪙</div>
        <h1 class="font-rpg text-3xl sm:text-4xl font-bold text-amber-950 leading-tight">
          Warung Josjis
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 font-medium">
          Kisah Bima merintis toko kelontong pertamanya dari tabungan Rp 30 Juta!
        </p>
      </div>

      <div class="space-y-3 pt-1">
        <button onclick="handleStartButtonClick()" class="btn-rpg w-full bg-emerald-500 border-emerald-700 text-white font-rpg font-bold py-3.5 rounded-2xl text-lg shadow-lg flex items-center justify-center gap-2">
          <span>▶</span>
          <span>Mulai</span>
        </button>

        <button onclick="openSettingsMenu(true)" class="btn-rpg w-full bg-amber-400 border-amber-600 text-amber-950 font-rpg font-bold py-3.5 rounded-2xl text-lg shadow-lg flex items-center justify-center gap-2">
          <span>⚙️</span>
          <span>Menu</span>
        </button>

        <button onclick="handleExitGame()" class="btn-rpg w-full bg-rose-500 border-rose-700 text-white font-rpg font-bold py-3.5 rounded-2xl text-lg shadow-lg flex items-center justify-center gap-2">
          <span>🚪</span>
          <span>Keluar</span>
        </button>
      </div>

      <div class="text-[11px] text-slate-500 font-semibold">
        Gunakan Analog / WASD untuk bergerak • Lari untuk mempercepat langkah Bima
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- LAYAR KELUAR GAME                                                     -->
  <!-- ===================================================================== -->
  <div id="exit-game-screen" class="hidden fixed inset-0 z-[60] bg-slate-950 text-white flex flex-col items-center justify-center p-6 text-center">
    <div class="max-w-md space-y-4">
      <div class="text-5xl">👋🏪</div>
      <h2 class="font-rpg text-2xl sm:text-3xl font-bold text-amber-300">Terima Kasih Telah Bermain!</h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        Kamu telah keluar dari <b>Warung Josjis</b>. Jangan lupa terapkan ilmu memisahkan modal usaha, biaya sewa, perlengkapan, dan tabungan di dunia nyata!
      </p>
      <div class="pt-3">
        <button onclick="returnToMainMenu()" class="btn-rpg bg-emerald-500 border-emerald-700 text-white font-rpg font-bold px-6 py-3 rounded-2xl text-sm">
          🔄 Kembali ke Layar Utama
        </button>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL MENU PENGATURAN (VOLUME & KUSTOM HUD)                           -->
  <!-- ===================================================================== -->
  <div id="modal-settings" class="hidden fixed inset-0 z-[55] bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-3">
    <div class="animate-modal bg-amber-50 border-4 border-amber-700 rounded-3xl w-full max-w-md overflow-hidden shadow-2xl">
      <div class="bg-amber-500 text-amber-950 px-5 py-3 flex items-center justify-between border-b-4 border-amber-700">
        <div class="flex items-center gap-2">
          <span class="text-2xl">⚙️</span>
          <h2 class="font-rpg text-lg font-bold">Menu Pengaturan</h2>
        </div>
        <button onclick="closeSettingsMenu()" class="bg-amber-800 text-white rounded-xl px-3 py-1 text-sm font-bold">✕</button>
      </div>

      <div class="p-5 space-y-5">
        <div class="bg-white border-2 border-amber-200 rounded-2xl p-4 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="font-rpg font-bold text-slate-800 text-base">🔊 Volume Audio & Musik</span>
            <span id="settings-volume-label" class="font-rpg font-bold text-emerald-700 text-sm">80%</span>
          </div>
          <input
            id="settings-volume-slider"
            type="range"
            min="0"
            max="100"
            value="80"
            oninput="updateMasterVolume(this.value)"
            class="w-full accent-emerald-600 cursor-pointer h-2.5 bg-amber-200 rounded-lg"
          />
          <p class="text-[11px] text-slate-500">Geser ke 0% untuk membisukan efek suara koin, pintu, dan musik latar.</p>
        </div>

        <div class="bg-white border-2 border-indigo-200 rounded-2xl p-4 space-y-3">
          <div>
            <h3 class="font-rpg font-bold text-indigo-950 text-base">🎮 Kustom Tata Letak HUD</h3>
            <p class="text-xs text-slate-600 mt-0.5">
              Atur posisi <b>Tombol Analog</b>, <b>Tombol Interaksi</b>, dan <b>Tombol Lari</b> sesuai kenyamanan jarimu di layar.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-2">
            <button onclick="enterHudCustomizeMode()" class="btn-rpg flex-1 bg-indigo-600 border-indigo-800 text-white font-rpg font-bold py-2.5 px-3 rounded-xl text-xs sm:text-sm">
              ✋ Atur Tata Letak Tombol
            </button>
            <button onclick="resetCustomHudLayout()" class="btn-rpg bg-slate-200 border-slate-400 text-slate-800 font-rpg font-bold py-2.5 px-3 rounded-xl text-xs">
              ↺ Reset Default
            </button>
          </div>
        </div>

        <button onclick="closeSettingsMenu()" class="btn-rpg w-full bg-emerald-500 border-emerald-700 text-white font-rpg font-bold py-2.5 rounded-2xl text-sm">
          Simpan & Tutup
        </button>
      </div>
    </div>
  </div>

  <!-- Banner Mode Edit Kustom HUD -->
  <div id="hud-customize-bar" class="hidden fixed top-3 left-1/2 -translate-x-1/2 z-[58] bg-slate-900/95 text-white border-2 border-yellow-400 rounded-2xl px-4 py-2.5 shadow-2xl flex items-center gap-3">
    <span class="text-xs sm:text-sm font-bold text-yellow-300">✋ Seret Tombol Analog, Interaksi, atau Lari untuk memindahkannya!</span>
    <button onclick="exitHudCustomizeMode()" class="btn-rpg bg-emerald-500 border-emerald-700 text-white font-rpg font-bold px-3.5 py-1.5 rounded-xl text-xs whitespace-nowrap">
      ✅ Selesai
    </button>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL PEMERIKSAAN TABUNGAN RP 30 JUTA & RENCANA MODAL AWAL BIMA       -->
  <!-- ===================================================================== -->
  <div id="modal-initial-budget" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-3">
    <div class="animate-modal bg-amber-50 border-4 border-emerald-700 rounded-3xl w-full max-w-xl overflow-hidden shadow-2xl">
      <div class="bg-emerald-600 text-white px-5 py-3.5 border-b-4 border-emerald-800 flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-white border-2 border-emerald-900 overflow-hidden shrink-0" id="budget-bima-avatar"></div>
        <div>
          <h2 class="font-rpg text-lg sm:text-xl font-bold leading-tight">Perencanaan Modal Usaha Bima</h2>
          <p class="text-xs text-emerald-100">Memeriksa Tabungan Awal & Rincian Biaya Pembukaan Toko Pertama</p>
        </div>
      </div>

      <div class="p-4 sm:p-5 space-y-4 max-h-[82vh] overflow-y-auto rpg-scroll">
        <div class="bg-sky-100 border-2 border-sky-400 rounded-2xl p-3.5 flex items-center justify-between">
          <div>
            <div class="text-xs font-extrabold uppercase text-sky-800">Total Tabungan Bima Saat Ini</div>
            <div class="text-[11px] text-sky-700">Hasil menabung & bekerja keras sebelum buka usaha</div>
          </div>
          <div class="font-rpg text-xl sm:text-2xl font-bold text-sky-950">Rp 30.000.000</div>
        </div>

        <div class="bg-white border-2 border-amber-200 rounded-2xl p-3.5 space-y-2.5 text-xs sm:text-sm">
          <div class="font-rpg font-bold text-amber-950 text-sm border-b border-amber-200 pb-1.5">
            📋 Rincian Anggaran Pembukaan Toko Pertama:
          </div>

          <div class="flex items-center justify-between py-1">
            <div class="flex items-center gap-2">
              <span class="text-lg">🏠</span>
              <div>
                <div class="font-bold text-slate-800">1. Sewa Toko Pertama (1 Tahun)</div>
                <div class="text-[11px] text-slate-500">Kontrak tempat strategis di pinggir jalan kampung</div>
              </div>
            </div>
            <span class="font-rpg font-bold text-rose-600">- Rp 5.000.000</span>
          </div>

          <div class="flex items-center justify-between py-1 border-t border-slate-100">
            <div class="flex items-center gap-2">
              <span class="text-lg">🗄️</span>
              <div>
                <div class="font-bold text-slate-800">2. Perlengkapan & Perabotan Toko</div>
                <div class="text-[11px] text-slate-500">Rak display, etalase, meja kasir, kulkas & timbangan</div>
              </div>
            </div>
            <span class="font-rpg font-bold text-rose-600">- Rp 15.000.000</span>
          </div>

          <div class="flex items-center justify-between py-1 border-t border-slate-100">
            <div class="flex items-center gap-2">
              <span class="text-lg">📦</span>
              <div>
                <div class="font-bold text-slate-800">3. Stok Barang Dagangan Awal</div>
                <div class="text-[11px] text-slate-500">Sembako, minuman segar, jajanan & alat tulis pelajar</div>
              </div>
            </div>
            <span class="font-rpg font-bold text-rose-600">- Rp 1.500.000</span>
          </div>

          <div class="border-t-2 border-dashed border-amber-300 pt-2.5 flex items-center justify-between font-extrabold text-sm sm:text-base">
            <span class="text-slate-700">Total Investasi Awal Terpakai:</span>
            <span class="font-rpg text-amber-800">Rp 21.500.000</span>
          </div>

          <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-2.5 flex items-center justify-between">
            <span class="font-bold text-emerald-900 text-xs sm:text-sm">💰 Sisa Saldo untuk Kas Usaha & Cadangan:</span>
            <span class="font-rpg font-bold text-emerald-700 text-base sm:text-lg">Rp 8.500.000</span>
          </div>
        </div>

        <button onclick="confirmInitialBudgetSetup()" class="btn-rpg w-full bg-emerald-500 border-emerald-700 text-white font-rpg font-bold py-3 rounded-2xl text-base shadow-lg">
          ✅ Cairkan Anggaran & Buka Warung Josjis!
        </button>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- TOP HUD                                                               -->
  <!-- ===================================================================== -->
  <header class="z-20 bg-amber-50/95 backdrop-blur-md border-b-4 border-amber-700/30 px-2 sm:px-4 py-1.5 shadow-lg">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-1.5 sm:gap-3">
      <div class="flex items-center gap-2 bg-amber-100 border-2 border-amber-300 rounded-2xl px-2.5 py-1 shadow-inner">
        <div class="text-xl sm:text-2xl" id="hud-weather-icon" title="Cuaca Hari Ini">☀️</div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-rpg font-bold text-amber-900 text-xs sm:text-sm" id="hud-day">Hari ke-1</span>
            <span class="text-[10px] sm:text-xs font-bold px-1.5 py-0.5 rounded-full bg-amber-600 text-white" id="hud-level-badge">Warung Josjis Lv.1</span>
          </div>
          <div class="flex items-center gap-1.5 text-xs sm:text-sm font-extrabold text-slate-700">
            <span id="hud-clock">07:00</span>
            <span class="text-[10px] font-semibold text-amber-700" id="hud-day-name">(Senin)</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <div onclick="openModal('modal-finance')" class="cursor-pointer bg-emerald-50 hover:bg-emerald-100 transition border-2 border-emerald-400 rounded-2xl px-2.5 py-1 flex items-center gap-1.5 shadow-sm" title="Kas Usaha">
          <span class="text-lg sm:text-xl">🏪</span>
          <div>
            <div class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-emerald-700 leading-none">Kas Usaha</div>
            <div class="font-rpg font-bold text-emerald-900 text-xs sm:text-base leading-tight" id="hud-business-cash">Rp 8.500.000</div>
          </div>
        </div>

        <div onclick="openModal('modal-savings')" class="cursor-pointer bg-sky-50 hover:bg-sky-100 transition border-2 border-sky-400 rounded-2xl px-2.5 py-1 flex items-center gap-1.5 shadow-sm" title="Tabungan & Dompet Pribadi">
          <span class="text-lg sm:text-xl">🐷</span>
          <div>
            <div class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-sky-700 leading-none">Tabungan</div>
            <div class="font-rpg font-bold text-sky-900 text-xs sm:text-base leading-tight" id="hud-savings-cash">Rp 0</div>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <div class="hidden md:flex flex-col bg-rose-50 border-2 border-rose-200 rounded-2xl px-2.5 py-1 min-w-[105px]">
          <div class="flex justify-between text-[10px] font-bold text-rose-800">
            <span>⚡ Energi</span>
            <span id="hud-energy-text">100%</span>
          </div>
          <div class="w-full h-2 bg-rose-200 rounded-full overflow-hidden mt-0.5">
            <div id="hud-energy-bar" class="h-full bg-gradient-to-r from-rose-500 to-amber-400 transition-all duration-300" style="width: 100%"></div>
          </div>
        </div>

        <div class="bg-yellow-50 border-2 border-yellow-300 rounded-2xl px-2.5 py-1 flex items-center gap-1" title="Reputasi Warung">
          <span class="text-sm sm:text-base">⭐</span>
          <span class="font-rpg font-bold text-yellow-800 text-xs sm:text-sm" id="hud-reputation">3.0</span>
        </div>

        <button id="btn-audio-toggle" onclick="toggleAudio()" class="btn-rpg bg-amber-200 border-amber-400 text-amber-900 p-2 rounded-xl text-sm font-bold" title="Suara & Musik">
          🔊
        </button>

        <button onclick="openSettingsMenu(false)" class="btn-rpg bg-slate-200 border-slate-400 text-slate-900 p-2 rounded-xl text-sm font-bold" title="Pengaturan">
          ⚙️
        </button>

        <button onclick="openModal('modal-characters')" class="btn-rpg bg-pink-500 border-pink-700 text-white px-2.5 py-2 rounded-xl text-xs sm:text-sm font-bold" title="Tokoh & Promosi">
          👥
        </button>

        <button id="btn-hp-open" onclick="openPhoneModal()" class="btn-rpg relative bg-emerald-500 border-emerald-700 text-white px-2.5 py-2 rounded-xl text-xs sm:text-sm font-bold" title="HP Bima (Aplikasi Restok)">
          📱
          <span id="hp-notif-badge" class="hidden absolute -top-1.5 -right-1.5 bg-rose-600 text-white text-[10px] font-extrabold px-1.5 py-0.2 rounded-full border border-white animate-bounce">!</span>
        </button>

        <button onclick="openModal('modal-guide')" class="btn-rpg bg-indigo-500 border-indigo-700 text-white px-2.5 py-2 rounded-xl text-xs sm:text-sm font-bold" title="Panduan">
          ❓
        </button>
      </div>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- MAIN GAME VIEWPORT (2.5D REALISTIC CITAMPI-STYLE CANVAS)              -->
  <!-- ===================================================================== -->
  <main id="game-container">
    <canvas id="warungCanvas"></canvas>

    <div id="news-ticker" class="pointer-events-none absolute top-3 left-1/2 -translate-x-1/2 z-10 w-[92%] max-w-xl">
      <div class="bg-slate-900/85 backdrop-blur-sm text-amber-200 border-2 border-amber-400/60 rounded-full px-4 py-1.5 text-xs sm:text-sm font-semibold shadow-lg flex items-center justify-center gap-2 text-center">
        <span id="news-icon">📢</span>
        <span id="news-text">Selamat pagi Bima! Om Heri siap membantumu memulai hari pertama berjualan di Warung Josjis.</span>
      </div>
    </div>

    <div id="promo-banner" class="hidden pointer-events-none absolute top-14 left-1/2 -translate-x-1/2 z-10">
      <div class="bg-gradient-to-r from-pink-600 via-purple-600 to-indigo-600 text-white border-2 border-yellow-300 rounded-full px-4 py-1 text-xs font-extrabold shadow-xl flex items-center gap-2 animate-bounce">
        <span>🎥✨</span>
        <span id="promo-banner-text">LIVE PROMO BIM WING! Pelanggan berdatangan 2x lebih ramai!</span>
      </div>
    </div>

    <!-- KONTROL HUD KUSTOMISASI -->
    <div id="hud-analog-wrapper" class="hud-draggable absolute bottom-24 left-4 z-20 w-28 h-28 rounded-full bg-slate-900/45 border-2 border-white/40 backdrop-blur-[2px] flex items-center justify-center shadow-xl">
      <div id="hud-analog-knob" class="w-12 h-12 rounded-full bg-amber-400/90 border-2 border-amber-100 shadow-lg pointer-events-none flex items-center justify-center text-amber-950 font-bold text-xs">
        🕹️
      </div>
    </div>

    <div id="hud-interact-wrapper" class="hud-draggable absolute bottom-24 right-24 z-20">
      <button id="interaction-btn" onclick="triggerNearestInteraction()" class="btn-rpg bg-amber-400 border-amber-600 text-amber-950 font-rpg font-bold w-16 h-16 sm:w-auto sm:h-auto sm:px-5 sm:py-3 rounded-full sm:rounded-2xl shadow-xl text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-center gap-1">
        <span id="interaction-icon" class="text-lg">👉</span>
        <span id="interaction-label" class="text-[10px] sm:text-sm leading-none">Interaksi</span>
      </button>
    </div>

    <div id="hud-sprint-wrapper" class="hud-draggable absolute bottom-24 right-4 z-20">
      <button id="hud-sprint-btn" class="btn-rpg bg-sky-500 border-sky-700 text-white font-rpg font-bold w-16 h-16 rounded-full shadow-xl flex flex-col items-center justify-center">
        <span class="text-lg leading-none">👟</span>
        <span class="text-[10px] mt-0.5">Lari</span>
      </button>
    </div>

    <div id="toast-container" class="pointer-events-none absolute top-14 right-3 z-30 flex flex-col gap-2 max-w-xs"></div>

    <!-- KOTAK DIALOG VISUAL NOVEL RPG -->
    <div id="vn-dialog-overlay" class="hidden fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-[2px] flex items-end justify-center p-3 sm:p-6">
      <div class="animate-modal w-full max-w-3xl bg-amber-50 border-4 border-amber-800 rounded-3xl shadow-2xl overflow-hidden">
