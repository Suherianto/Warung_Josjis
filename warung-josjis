    function orderRestockBundle() {
      if (gameState.restockOrderTimer > 0 || gameState.restockBoxReady) {
        showToast('Masih ada pesanan restok yang sedang diproses!', 'info');
        return;
      }

      const totalCost = getRestockBundleTotalCost();
      const totalItemsToAdd = PRODUCTS_MASTER.length * RESTOCK_BUNDLE_QTY;

      if (getTotalStockCount() + totalItemsToAdd > getMaxStockCapacity()) {
        SoundFX.error();
        showToast('Kapasitas rak toko belum cukup untuk paket restok penuh!', 'error');
        return;
      }

      if (gameState.businessCash < totalCost) {
        SoundFX.error();
        showToast('Kas Usaha tidak cukup untuk membeli paket restok!', 'error');
        return;
      }

      gameState.businessCash -= totalCost;
      gameState.restockOrderTimer = 60;
      addLog('Pesan Paket Restok via Aplikasi Keranjang HP', -totalCost, 'out');
      SoundFX.buy();
      updatePhoneOrderUI();
      updateAllUI();
      saveGame();
      showToast('Pesanan restok dikirim! Tunggu ±1 menit hingga notifikasi HP berbunyi.', 'success');
    }

