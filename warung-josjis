    function setupHudControls() {
      ['hud-analog-wrapper', 'hud-interact-wrapper', 'hud-sprint-wrapper'].forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        let dragging = false;
        let offsetX = 0;
        let offsetY = 0;

        el.addEventListener('pointerdown', (e) => {
          if (!isHudCustomizeMode) return;
          e.stopPropagation();
          dragging = true;
          const rect = el.getBoundingClientRect();
          const parentRect = document.getElementById('game-container').getBoundingClientRect();
          offsetX = e.clientX - rect.left;
          offsetY = e.clientY - rect.top;
          el.style.left = (rect.left - parentRect.left) + 'px';
          el.style.top = (rect.top - parentRect.top) + 'px';
          el.style.right = 'auto';
          el.style.bottom = 'auto';
          el.setPointerCapture(e.pointerId);
        });

        el.addEventListener('pointermove', (e) => {
          if (!dragging || !isHudCustomizeMode) return;
          const parentRect = document.getElementById('game-container').getBoundingClientRect();
          const newLeft = Math.max(4, Math.min(parentRect.width - el.offsetWidth - 4, e.clientX - parentRect.left - offsetX));
          const newTop = Math.max(4, Math.min(parentRect.height - el.offsetHeight - 4, e.clientY - parentRect.top - offsetY));
          el.style.left = newLeft + 'px';
          el.style.top = newTop + 'px';
        });

        el.addEventListener('pointerup', () => {
          dragging = false;
        });
      });

      const analogWrap = document.getElementById('hud-analog-wrapper');
      const analogKnob = document.getElementById('hud-analog-knob');
      if (analogWrap && analogKnob) {
        const maxRadius = 34;
        const updateAnalog = (clientX, clientY) => {
          const rect = analogWrap.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          let dx = clientX - cx;
          let dy = clientY - cy;
          const dist = Math.hypot(dx, dy);
          if (dist > maxRadius) {
            dx = (dx / dist) * maxRadius;
            dy = (dy / dist) * maxRadius;
          }
          analogKnob.style.transform = `translate(${dx}px, ${dy}px)`;
          analogInput.x = dx / maxRadius;
          analogInput.y = dy / maxRadius;
        };

        analogWrap.addEventListener('pointerdown', (e) => {
          if (isHudCustomizeMode) return;
          SoundFX.ensureBGM();
          analogInput.active = true;
          analogWrap.setPointerCapture(e.pointerId);
          updateAnalog(e.clientX, e.clientY);
        });
        analogWrap.addEventListener('pointermove', (e) => {
          if (!analogInput.active || isHudCustomizeMode) return;
          updateAnalog(e.clientX, e.clientY);
        });
        const resetAnalog = () => {
          analogInput.active = false;
          analogInput.x = 0;
          analogInput.y = 0;
          analogKnob.style.transform = 'translate(0px, 0px)';
        };
        analogWrap.addEventListener('pointerup', resetAnalog);
        analogWrap.addEventListener('pointercancel', resetAnalog);
      }

      const sprintBtn = document.getElementById('hud-sprint-btn');
      if (sprintBtn) {
        sprintBtn.addEventListener('pointerdown', (e) => {
          if (isHudCustomizeMode) return;
          e.stopPropagation();
          player.isSprinting = true;
          sprintBtn.classList.add('ring-4', 'ring-yellow-300');
        });
        const stopSprint = () => {
          player.isSprinting = false;
          sprintBtn.classList.remove('ring-4', 'ring-yellow-300');
        };
        sprintBtn.addEventListener('pointerup', stopSprint);
        sprintBtn.addEventListener('pointerleave', stopSprint);
        sprintBtn.addEventListener('pointercancel', stopSprint);
      }
    }

