    canvas.addEventListener('pointerdown', (e) => {
      SoundFX.ensureBGM();
      const rect = canvas.getBoundingClientRect();
      const sx = (e.clientX - rect.left) * (WORLD.width / rect.width);
      const sy = (e.clientY - rect.top) * (WORLD.height / rect.height);
      const wx = (sx - WORLD.width / 2) / cam25D.zoom + cam25D.x;
      const wy = (sy - WORLD.height / 2) / cam25D.zoom + cam25D.y;

      const clickedZone = ZONES.find(z => Math.hypot(wx - z.x, wy - z.y) <= z.r + 16);
      if (clickedZone) {
        player.targetX = clickedZone.x;
        player.targetY = Math.min(350, Math.max(135, clickedZone.y));
        player.pendingZone = clickedZone;
        SoundFX.pop();
        return;
      }

      const wr = WORLD.warungRect;
      if (wx >= wr.x + 28 && wx <= wr.x + wr.w - 28 && wy >= wr.y + 52 && wy <= wr.y + wr.h - 20) {
        player.targetX = wx;
        player.targetY = wy;
        player.pendingZone = null;
      }
    });

    function resizeCanvas() {
      const container = document.getElementById('game-container');
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = WORLD.width * dpr;
      canvas.height = WORLD.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (container) {
        canvas.style.width = '100%';
        canvas.style.height = '100%';
      }
    }

    let lastTimestamp = 0;
    let spawnTimer = 3.0;
    let isPausedByModal = false;

    function gameLoop(timestamp) {
      if (!lastTimestamp) lastTimestamp = timestamp;
      const dt = Math.min(0.05, (timestamp - lastTimestamp) / 1000);
      lastTimestamp = timestamp;

      updateGame(dt);
      render25DWorld();

      requestAnimationFrame(gameLoop);
    }

    /**
     * =========================================================================
     * 7. LOOP SIMULASI & LOGIKA UPDATE GAME
     * =========================================================================
     */
    function updateGame(dt) {
      if (introCutscene.active) {
        introCutscene.progress = Math.min(1, introCutscene.progress + dt * 0.55);
        introCutscene.doorOpenAmount = Math.min(1, introCutscene.progress * 2.2);
        player.y = 425 - introCutscene.progress * 155;
        player.dir = 'up';
        player.walkFrame += dt * 1.4;
        if (introCutscene.progress >= 1) {
          introCutscene.active = false;
          player.dir = 'down';
          onIntroCutsceneFinished();
        }
        return;
      }

      if (isPausedByModal) return;

      gameState.timeMinutes += dt * 2.5;
      if (gameState.timeMinutes >= 20 * 60) {
        openEndOfDayReport();
        return;
      }

      if (!gameState.eventTriggeredToday && gameState.timeMinutes >= 12 * 60 + 30 && gameState.day >= 2) {
        gameState.eventTriggeredToday = true;
        triggerRandomDailyEvent();
      }

      if (gameState.bimWingPromoTimer > 0) {
        gameState.bimWingPromoTimer = Math.max(0, gameState.bimWingPromoTimer - dt);
        if (gameState.bimWingPromoTimer === 0) {
          document.getElementById('promo-banner').classList.add('hidden');
          if (specialVisitor && specialVisitor.roleType === 'bim_wing') specialVisitor = null;
        }
      }

      // Pergerakan Bima
      let vx = analogInput.x;
      let vy = analogInput.y;
      if (keys['ArrowUp'] || keys['w'] || keys['W']) vy -= 1;
      if (keys['ArrowDown'] || keys['s'] || keys['S']) vy += 1;
      if (keys['ArrowLeft'] || keys['a'] || keys['A']) vx -= 1;
      if (keys['ArrowRight'] || keys['d'] || keys['D']) vx += 1;

      const currentSpeed = player.isSprinting ? player.speed * 1.65 : player.speed;

      if (Math.hypot(vx, vy) > 0.08) {
        player.targetX = null;
        player.targetY = null;
        player.pendingZone = null;
        const len = Math.hypot(vx, vy);
        const normX = len > 1 ? vx / len : vx;
        const normY = len > 1 ? vy / len : vy;
        player.x += normX * currentSpeed * dt;
        player.y += normY * currentSpeed * dt;
        player.walkFrame += dt * (player.isSprinting ? 1.5 : 1.0);
        if (Math.abs(normX) > Math.abs(normY)) player.dir = normX < 0 ? 'left' : 'right';
        else player.dir = normY < 0 ? 'up' : 'down';
      } else if (player.targetX !== null && player.targetY !== null) {
        const dx = player.targetX - player.x;
        const dy = player.targetY - player.y;
        const dist = Math.hypot(dx, dy);
        if (dist > 5) {
          player.x += (dx / dist) * currentSpeed * dt;
          player.y += (dy / dist) * currentSpeed * dt;
          player.walkFrame += dt * (player.isSprinting ? 1.5 : 1.0);
          if (Math.abs(dx) > Math.abs(dy)) player.dir = dx < 0 ? 'left' : 'right';
          else player.dir = dy < 0 ? 'up' : 'down';
        } else {
          player.targetX = null;
          player.targetY = null;
          if (player.pendingZone) {
            const z = player.pendingZone;
            player.pendingZone = null;
            z.action();
          }
        }
      }

      const wr = WORLD.warungRect;
      player.x = Math.max(wr.x + 28, Math.min(wr.x + wr.w - 28, player.x));
      player.y = Math.max(wr.y + 52, Math.min(wr.y + wr.h - 24, player.y));

      const nearZone = ZONES.find(z => Math.hypot(player.x - z.x, player.y - z.y) <= z.r);
      const interactBtn = document.getElementById('interaction-btn');
      if (nearZone) {
        document.getElementById('interaction-icon').textContent = nearZone.icon;
        document.getElementById('interaction-label').textContent = nearZone.label;
        interactBtn.classList.remove('opacity-75');
      } else {
        document.getElementById('interaction-icon').textContent = '👉';
        document.getElementById('interaction-label').textContent = 'Interaksi';
        interactBtn.classList.add('opacity-75');
      }

      // Timer Kurir Restok
      if (gameState.restockOrderTimer > 0) {
        gameState.restockOrderTimer = Math.max(0, gameState.restockOrderTimer - dt);
        updatePhoneOrderUI();
        if (gameState.restockOrderTimer === 0) {
          gameState.restockBoxReady = true;
          document.getElementById('hp-notif-badge').classList.remove('hidden');
          SoundFX.bell();
          showToast('📱 Ting! Paket restok sudah tiba di Ruang Restok!', 'success');
          saveGame();
        }
      }

      // Spawn Customer
      spawnTimer -= dt;
      if (spawnTimer <= 0) {
        const nearCashier = Math.hypot(player.x - 480, player.y - 315) < 130;
        if (gameState.shopOpen && nearCashier) {
          spawnCustomer();
        }
        const repFactor = Math.max(0.45, 4.3 - gameState.reputation * 0.5);
        const bannerFactor = gameState.upgrades.includes('neon_banner') ? 0.78 : 1.0;
        const bimWingFactor = gameState.bimWingPromoTimer > 0 ? 0.42 : 1.0;
        spawnTimer = (2.8 + Math.random() * 1.8) * repFactor * bannerFactor * bimWingFactor;
      }

      // Update Pelanggan
      const waitingList = customers.filter(c => c.state === 'waiting' || c.state === 'walking_cashier');
      for (let i = customers.length - 1; i >= 0; i--) {
        const c = customers[i];

        if (c.state === 'browsing') {
          const wp = c.waypoints[0];
          if (!wp) {
            c.state = 'walking_cashier';
          } else {
            const dx = wp.x - c.x;
            const dy = wp.y - c.y;
            const dist = Math.hypot(dx, dy);
            if (dist > 5) {
              c.x += (dx / dist) * 110 * dt;
              c.y += (dy / dist) * 110 * dt;
              c.walkFrame += dt;
            } else {
              c.browsePause -= dt;
              if (c.browsePause <= 0) {
                spawnFloatingText(c.x, c.y - 32, `+1 ${wp.icon}`, '#38bdf8');
                c.waypoints.shift();
                c.browsePause = 0.65;
                if (c.waypoints.length === 0) {
                  c.state = 'walking_cashier';
                }
              }
            }
          }
        } else if (c.state === 'walking_cashier') {
          const qIdx = Math.max(0, waitingList.indexOf(c));
          const tx = 480 + qIdx * 46;
          const ty = 355;
          const dx = tx - c.x;
          const dy = ty - c.y;
          const dist = Math.hypot(dx, dy);
          if (dist > 4) {
            c.x += (dx / dist) * 115 * dt;
            c.y += (dy / dist) * 115 * dt;
            c.walkFrame += dt;
          } else {
            c.state = 'waiting';
            updateCashierBadge();
          }
        } else if (c.state === 'waiting') {
          const qIdx = Math.max(0, waitingList.indexOf(c));
          c.x += ((480 + qIdx * 46) - c.x) * 0.15;
          const drainRate = qIdx === 0 ? 2.5 : 1.4;
          c.patience -= drainRate * dt;
          if (c.patience <= 0) {
            c.state = 'leaving';
            c.targetX = 480;
            c.targetY = 445;
            gameState.reputation = Math.max(1.0, +(gameState.reputation - 0.15).toFixed(2));
            spawnFloatingText(c.x, c.y - 35, '😠 Kelamaan antre!', '#f87171');
            SoundFX.error();
          }
        } else if (c.state === 'leaving') {
          const exitDoorX = 480;
          const exitDoorY = 445;
          if (c.y < exitDoorY - 6) {
            const dx = exitDoorX - c.x;
            const dy = exitDoorY - c.y;
            const dist = Math.hypot(dx, dy);
            c.x += (dx / dist) * 125 * dt;
            c.y += (dy / dist) * 125 * dt;
            c.walkFrame += dt;
          } else {
            c.x += 145 * dt;
            c.walkFrame += dt;
            if (c.x > WORLD.width + 45) {
              customers.splice(i, 1);
              updateCashierBadge();
            }
          }
        }
      }

      // Kendaraan di Jalan Aspal
      vehicles.forEach(v => {
        v.x += v.speed * dt;
        if (v.speed > 0 && v.x > WORLD.width + 70) v.x = -70;
        if (v.speed < 0 && v.x < -70) v.x = WORLD.width + 70;
      });

      // Awan, Hujan & Partikel Teks
      clouds.forEach(cl => {
        cl.x += cl.speed * dt;
        if (cl.x > WORLD.width + 80) cl.x = -80;
      });
      if (gameState.weather === 'rainy') {
        rainDrops.forEach(r => {
          r.y += r.speed * dt;
          r.x -= 90 * dt;
          if (r.y > WORLD.height) {
            r.y = -15;
            r.x = Math.random() * WORLD.width;
          }
        });
      }
      for (let i = floatingParticles.length - 1; i >= 0; i--) {
        const p = floatingParticles[i];
        p.y += p.vy * dt;
        p.life -= dt;
        if (p.life <= 0) floatingParticles.splice(i, 1);
      }

      updateHUDClock();
    }

