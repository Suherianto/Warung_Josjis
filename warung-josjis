        showToast(`Kurir masih di jalan (${Math.ceil(gameState.restockOrderTimer)} detik lagi)...`, 'info');
        return;
      }

      if (!gameState.restockBoxReady) {
        const remainingToPlace = Object.values(gameState.carryingRestockItems).reduce((a, b) => a + b, 0);
        if (remainingToPlace > 0) {
          showToast('Kamu sudah mengambil kardus restok! Taruh ke masing-masing rak satu per satu.', 'info');
        } else {
          showToast('Ruang Restok kosong. Buka HP -> Keranjang untuk pesan restok dulu!', 'info');
        }
        return;
      }

      gameState.restockBoxReady = false;
      document.getElementById('hp-notif-badge').classList.add('hidden');
      PRODUCTS_MASTER.forEach(p => {
        gameState.carryingRestockItems[p.id] = (gameState.carryingRestockItems[p.id] || 0) + RESTOCK_BUNDLE_QTY;
      });
      SoundFX.buy();
      saveGame();
      showToast('📦 Kardus restok diambil! Sekarang datangi tiap rak untuk mengisi stok satu per satu.', 'success');
    }

    function interactSingleRack(rack) {
      const carryQty = gameState.carryingRestockItems[rack.prodId] || 0;
      const prod = PRODUCTS_MASTER.find(p => p.id === rack.prodId);

      if (carryQty <= 0) {
        showToast(`${rack.label}: Stok saat ini ${getProductTotalQty(rack.prodId)} pcs. Tidak ada restok yang dibawa untuk rak ini.`, 'info');
        return;
      }

      const inv = gameState.inventory[rack.prodId];
      const bonusShelf = gameState.upgrades.includes('fridge') && (prod.category === 'minuman' || prod.category === 'sembako') ? 2 : 0;
      inv.batches.push({
        qty: carryQty,
        costPerUnit: inv.todayWholesaleCost,
        daysLeft: prod.shelfLife + bonusShelf
      });
      delete gameState.carryingRestockItems[rack.prodId];

      SoundFX.coin();
      spawnFloatingText(rack.x, rack.y - 20, `+${carryQty} ${prod.icon}`, '#4ade80');
      updateAllUI();
      saveGame();

      const leftCount = Object.keys(gameState.carryingRestockItems).length;
      if (leftCount === 0) {
        showToast(`✅ Semua rak telah selesai direstok!`, 'success');
      } else {
        showToast(`${rack.label} terisi +${carryQty}! Sisa ${leftCount} rak lagi untuk direstok.`, 'success');
      }
    }

