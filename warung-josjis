    function drawChibi25DCharacter(charType, x, y, dir = 'down', walkFrame = 0, label = '', bubbleText = '', badgeColor = '#0f172a') {
      ctx.save();
      const stepPhase = Math.sin(walkFrame * 10);
      const isMoving = Math.abs(stepPhase) > 0.12 && walkFrame > 0;
      const bobY = isMoving ? Math.abs(stepPhase) * 3.5 : Math.sin(performance.now() / 420) * 1.1;

      const footShadow = ctx.createRadialGradient(x, y + 2, 2, x, y + 2, 18);
      footShadow.addColorStop(0, 'rgba(15, 23, 42, 0.42)');
      footShadow.addColorStop(1, 'rgba(15, 23, 42, 0)');
      ctx.fillStyle = footShadow;
      ctx.beginPath();
      ctx.ellipse(x, y + 2, 18, 7, 0, 0, Math.PI * 2);
      ctx.fill();

      let skin = '#f3c69f';
      let skinShadow = '#d99b6c';
      let hair = '#111827';
      let hairHighlight = '#334155';
      let shirt = '#18181b';
      let pants = '#18181b';
      let shoe = '#e6b07e';
      let longHair = false;
      let ponytail = false;
      let headphones = false;
      let clipCol = null;

      if (charType === 'ahmad') {
        shirt = '#3f3f46'; pants = '#27272a'; shoe = '#09090b';
      } else if (charType === 'bim_wing') {
        shirt = '#1d4ed8'; pants = '#09090b'; shoe = '#09090b'; hairHighlight = '#3b82f6';
      } else if (charType === 'om_heri') {
        shirt = '#ffffff'; pants = '#78350f'; hair = '#4b5563';
      } else if (charType === 'npc1') {
        skin = '#fde6d8'; shirt = '#18181b'; pants = '#18181b'; shoe = '#f8fafc';
        longHair = true; ponytail = true; headphones = true; clipCol = '#ffffff';
      } else if (charType === 'npc2') {
        skin = '#fde6d8'; shirt = '#f1f5f9'; pants = '#18181b'; shoe = '#f8fafc'; hairHighlight = '#cbd5e1';
      } else if (charType === 'npc3') {
        skin = '#fde6d8'; shirt = '#111827'; pants = '#111827'; shoe = '#f8fafc';
      } else if (charType === 'npc4') {
        skin = '#fde6d8'; hair = '#1e1b4b'; shirt = '#18181b'; pants = '#18181b'; shoe = '#e9d5ff';
        headphones = true; clipCol = '#a855f7';
      } else if (charType === 'npc5') {
        skin = '#fde6d8'; shirt = '#18181b'; pants = '#2e1065'; shoe = '#f3e8ff';
        longHair = true; clipCol = '#c084fc';
      } else if (charType === 'npc6') {
        skin = '#fde6d8'; shirt = '#18181b'; pants = '#18181b'; shoe = '#f8fafc';
        longHair = true; clipCol = '#ffffff';
      }

      const drawY = y - bobY;
      ctx.lineWidth = 2.2;
      ctx.strokeStyle = '#09090b';

      if (longHair && dir !== 'up') {
        ctx.fillStyle = hair;
        drawRoundRect(x - 16, drawY - 46, 32, 34, 10);
        ctx.fill();
        ctx.stroke();
      }
      if (ponytail && dir !== 'up') {
        ctx.fillStyle = hair;
        drawRoundRect(x + (dir === 'left' ? 10 : -18), drawY - 48, 11, 28, 5);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(x + (dir === 'left' ? 11 : -16), drawY - 48, 8, 5);
      }

      const leftLegOffset = isMoving ? stepPhase * 4 : 0;
      const rightLegOffset = isMoving ? -stepPhase * 4 : 0;

      ctx.fillStyle = pants;
      drawRoundRect(x - 10, drawY - 14 + leftLegOffset * 0.4, 8, 12, 3);
      ctx.fill();
      ctx.stroke();
      drawRoundRect(x + 2, drawY - 14 + rightLegOffset * 0.4, 8, 12, 3);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = shoe;
      ctx.fillRect(x - 10, drawY - 4 + leftLegOffset * 0.4, 8, 4);
      ctx.fillRect(x + 2, drawY - 4 + rightLegOffset * 0.4, 8, 4);

      if (charType === 'om_heri') {
        ctx.fillStyle = '#78350f';
        drawRoundRect(x - 11, drawY - 16, 22, 12, 3);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#b45309';
        ctx.fillRect(x - 8, drawY - 14, 5, 8);
        ctx.fillRect(x + 3, drawY - 14, 5, 8);
      }

      ctx.fillStyle = shirt;
      drawRoundRect(x - 13, drawY - 29, 26, 17, 6);
      ctx.fill();
      ctx.stroke();

      if (charType === 'ahmad' && dir !== 'up') {
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.moveTo(x - 4, drawY - 28);
        ctx.lineTo(x + 4, drawY - 28);
        ctx.lineTo(x, drawY - 16);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = '#09090b';
        ctx.fillRect(x - 1.5, drawY - 27, 3, 9);
      } else if (charType === 'om_heri') {
        ctx.fillStyle = '#7f1d1d';
        ctx.beginPath();
        ctx.moveTo(x - 11, drawY - 28);
        ctx.lineTo(x - 5, drawY - 28);
        ctx.lineTo(x + 12, drawY - 14);
        ctx.lineTo(x + 6, drawY - 14);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      } else if (charType === 'bim_wing' && dir !== 'up') {
        ctx.strokeStyle = '#93c5fd';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(x - 4, drawY - 26);
        ctx.lineTo(x - 4, drawY - 19);
        ctx.moveTo(x + 4, drawY - 26);
        ctx.lineTo(x + 4, drawY - 19);
        ctx.stroke();
        ctx.strokeStyle = '#09090b';
        ctx.lineWidth = 2.2;
      }

      if (headphones && dir !== 'up') {
        ctx.fillStyle = '#f8fafc';
        ctx.beginPath();
        ctx.arc(x - 9, drawY - 28, 4.5, 0, Math.PI * 2);
        ctx.arc(x + 9, drawY - 28, 4.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      }

      const armSwing = isMoving ? stepPhase * 3.5 : 0;
      ctx.fillStyle = charType === 'om_heri' ? skin : shirt;
      drawRoundRect(x - 17, drawY - 28 - armSwing * 0.5, 6, 13, 3);
      ctx.fill();
      ctx.stroke();
      drawRoundRect(x + 11, drawY - 28 + armSwing * 0.5, 6, 13, 3);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = skin;
      drawRoundRect(x - 16, drawY - 56, 32, 28, 11);
      ctx.fill();

      ctx.fillStyle = skinShadow;
      ctx.beginPath();
      ctx.roundRect(x - 14, drawY - 34, 28, 6, 4);
      ctx.fill();

      ctx.strokeStyle = '#09090b';
      drawRoundRect(x - 16, drawY - 56, 32, 28, 11);
      ctx.stroke();

      if (dir === 'up') {
        if (charType === 'om_heri') {
          ctx.fillStyle = hair;
          drawRoundRect(x - 16, drawY - 47, 32, 18, 6);
          ctx.fill();
          ctx.stroke();
        } else {
          ctx.fillStyle = hair;
          drawRoundRect(x - 17, drawY - 58, 34, longHair ? 42 : 30, 11);
          ctx.fill();
          ctx.stroke();
        }
      } else {
        const eyeShiftX = dir === 'left' ? -4 : dir === 'right' ? 4 : 0;

        if (charType === 'om_heri') {
          ctx.fillStyle = hair;
          ctx.fillRect(x - 17, drawY - 49, 5, 13);
          ctx.fillRect(x + 12, drawY - 49, 5, 13);
          ctx.strokeStyle = skinShadow;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(x - 6, drawY - 50);
          ctx.lineTo(x + 6, drawY - 50);
          ctx.stroke();
        } else {
          ctx.fillStyle = hair;
          ctx.beginPath();
          ctx.moveTo(x - 17, drawY - 44);
          ctx.quadraticCurveTo(x - 18, drawY - 62, x, drawY - 60);
          ctx.quadraticCurveTo(x + 18, drawY - 62, x + 17, drawY - 44);
          ctx.quadraticCurveTo(x + 6, drawY - 50, x, drawY - 46);
          ctx.quadraticCurveTo(x - 6, drawY - 50, x - 17, drawY - 44);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();

          ctx.strokeStyle = hairHighlight;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(x - 9, drawY - 54);
          ctx.lineTo(x - 3, drawY - 55);
          ctx.moveTo(x + 4, drawY - 55);
          ctx.lineTo(x + 10, drawY - 54);
          ctx.stroke();

          if (clipCol) {
            ctx.strokeStyle = clipCol;
            ctx.lineWidth = 2.2;
            ctx.beginPath();
            ctx.moveTo(x + 7 + eyeShiftX * 0.5, drawY - 49);
            ctx.lineTo(x + 12 + eyeShiftX * 0.5, drawY - 45);
            ctx.moveTo(x + 12 + eyeShiftX * 0.5, drawY - 49);
            ctx.lineTo(x + 7 + eyeShiftX * 0.5, drawY - 45);
            ctx.stroke();
          }
        }

        ctx.fillStyle = '#09090b';
        ctx.strokeStyle = '#09090b';
        ctx.lineWidth = 2;
        if (charType === 'ahmad') {
          ctx.beginPath();
          ctx.arc(x - 6 + eyeShiftX, drawY - 40, 3.2, Math.PI, 0);
          ctx.arc(x + 6 + eyeShiftX, drawY - 40, 3.2, Math.PI, 0);
          ctx.stroke();
        } else {
          ctx.beginPath();
          ctx.arc(x - 6 + eyeShiftX, drawY - 41, 2.5, 0, Math.PI * 2);
          ctx.arc(x + 6 + eyeShiftX, drawY - 41, 2.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(x - 7 + eyeShiftX, drawY - 42.5, 1.5, 1.5);
          ctx.fillRect(x + 5 + eyeShiftX, drawY - 42.5, 1.5, 1.5);
        }

        ctx.fillStyle = 'rgba(244, 63, 94, 0.32)';
        ctx.beginPath();
        ctx.ellipse(x - 10 + eyeShiftX, drawY - 36, 3, 1.8, 0, 0, Math.PI * 2);
        ctx.ellipse(x + 10 + eyeShiftX, drawY - 36, 3, 1.8, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = '#09090b';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(x + eyeShiftX, drawY - 35, 4.2, 0.15 * Math.PI, 0.85 * Math.PI);
        ctx.stroke();
      }

      if (label) {
        ctx.font = 'bold 10px "Plus Jakarta Sans", sans-serif';
        const tw = ctx.measureText(label).width + 12;
        ctx.fillStyle = badgeColor;
        drawRoundRect(x - tw / 2, drawY - 75, tw, 15, 6);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.textAlign = 'center';
        ctx.fillText(label, x, drawY - 64.5);
      }

      if (bubbleText) {
        ctx.font = 'bold 10px "Plus Jakarta Sans", sans-serif';
        const bw = ctx.measureText(bubbleText).width + 14;
        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2;
        drawRoundRect(x - bw / 2, drawY - 96, bw, 18, 8);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#0f172a';
        ctx.textAlign = 'center';
        ctx.fillText(bubbleText, x, drawY - 83.5);
      }

      ctx.restore();
    }

    function render25DWorld() {
      ctx.save();
      ctx.clearRect(0, 0, WORLD.width, WORLD.height);

      const targetCamX = introCutscene.active ? 480 : 480 + (player.x - 480) * 0.16;
      const targetCamY = introCutscene.active ? (350 - introCutscene.progress * 55) : 295 + (player.y - 295) * 0.12;
      const targetZoom = introCutscene.active ? (0.94 + introCutscene.progress * 0.08) : 1.0;
      cam25D.x += (targetCamX - cam25D.x) * 0.12;
      cam25D.y += (targetCamY - cam25D.y) * 0.12;
      cam25D.zoom += (targetZoom - cam25D.zoom) * 0.12;

      ctx.translate(WORLD.width / 2, WORLD.height / 2);
      ctx.scale(cam25D.zoom, cam25D.zoom);
      ctx.translate(-cam25D.x, -cam25D.y);

      const isEvening = gameState.timeMinutes >= 17 * 60 + 30;

      // 1. Latar Rumput Kampung Tropis Bertekstur Realistis
      const grassGrad = ctx.createLinearGradient(0, 0, 0, WORLD.height);
      grassGrad.addColorStop(0, '#4d7c0f');
      grassGrad.addColorStop(0.5, '#3f6212');
      grassGrad.addColorStop(1, '#365314');
      ctx.fillStyle = grassGrad;
      ctx.fillRect(-100, -100, WORLD.width + 200, WORLD.height + 200);

      for (let gx = 20; gx < WORLD.width; gx += 48) {
        for (let gy = 25; gy < 385; gy += 44) {
          if (gx > 165 && gx < 795 && gy > 65 && gy < 395) continue;
          ctx.strokeStyle = 'rgba(163, 230, 53, 0.35)';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(gx, gy);
          ctx.lineTo(gx - 3, gy - 6);
          ctx.moveTo(gx + 3, gy);
          ctx.lineTo(gx + 6, gy - 5);
          ctx.stroke();
          if ((gx + gy) % 96 === 0) {
            ctx.fillStyle = '#fef08a';
            ctx.beginPath();
            ctx.arc(gx + 10, gy - 3, 2.2, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      clouds.forEach(cl => {
        const clGrad = ctx.createRadialGradient(cl.x + 15, cl.y - 4, 4, cl.x + 15, cl.y, 45 * cl.scale);
        clGrad.addColorStop(0, 'rgba(255, 255, 255, 0.36)');
        clGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = clGrad;
        ctx.beginPath();
        ctx.arc(cl.x, cl.y, 28 * cl.scale, 0, Math.PI * 2);
        ctx.arc(cl.x + 22 * cl.scale, cl.y - 4, 24 * cl.scale, 0, Math.PI * 2);
        ctx.arc(cl.x + 42 * cl.scale, cl.y + 2, 20 * cl.scale, 0, Math.PI * 2);
        ctx.fill();
      });

      // 2. Trotoar Paving Block, Selokan Air Reflektif & Jalan Aspal Kampung
      const paveGrad = ctx.createLinearGradient(0, 392, 0, 436);
      paveGrad.addColorStop(0, '#f5f5f4');
      paveGrad.addColorStop(1, '#d6d3d1');
      ctx.fillStyle = paveGrad;
      ctx.fillRect(-80, 392, WORLD.width + 160, 44);
      ctx.strokeStyle = 'rgba(120, 113, 108, 0.45)';
      ctx.lineWidth = 1.2;
      for (let px = -60; px < WORLD.width + 80; px += 28) {
        ctx.strokeRect(px, 392, 28, 22);
        ctx.strokeRect(px + 14, 414, 28, 22);
      }
      for (let kx = -60; kx < WORLD.width + 80; kx += 40) {
        ctx.fillStyle = (Math.floor(kx / 40) % 2 === 0) ? '#facc15' : '#1e293b';
        ctx.fillRect(kx, 432, 40, 5);
      }

      ctx.fillStyle = '#334155';
      ctx.fillRect(-80, 437, WORLD.width + 160, 9);
      const waterGrad = ctx.createLinearGradient(0, 439, 0, 444);
      waterGrad.addColorStop(0, '#38bdf8');
      waterGrad.addColorStop(1, '#0284c7');
      ctx.fillStyle = waterGrad;
      ctx.fillRect(-80, 439, WORLD.width + 160, 5);

      const roadGrad = ctx.createLinearGradient(0, WORLD.roadY, 0, WORLD.roadY + WORLD.roadH);
      roadGrad.addColorStop(0, '#334155');
      roadGrad.addColorStop(0.45, '#1e293b');
      roadGrad.addColorStop(1, '#0f172a');
      ctx.fillStyle = roadGrad;
      ctx.fillRect(-80, WORLD.roadY, WORLD.width + 160, WORLD.roadH);

      ctx.fillStyle = 'rgba(255, 255, 255, 0.04)';
