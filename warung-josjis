    function startNextDay() {
      const rev = gameState.todayStats.revenue;
      const cogs = gameState.todayStats.cogs;
      const opex = 5000;
      const net = rev - cogs - opex;

      gameState.businessCash = Math.max(0, gameState.businessCash - opex);
      if (net > 0) {
        const selected = document.querySelector('input[name="profit-alloc"]:checked')?.value || 'balanced';
        const ratios = selected === 'growth' ? [0.85, 0.10, 0.05] : selected === 'saver' ? [0.40, 0.45, 0.15] : [0.60, 0.25, 0.15];
        const toSav = Math.round(net * ratios[1]);
        const toWal = Math.round(net * ratios[2]);
        gameState.businessCash -= (toSav + toWal);
        gameState.eduSavings += toSav;
        gameState.walletCash += toWal;
      }

      if (gameState.eduSavings > 0) {
        gameState.eduSavings += Math.round(gameState.eduSavings * 0.02);
      }

      gameState.day += 1;
      gameState.timeMinutes = 7 * 60;
      gameState.energy = 100;
      gameState.eventTriggeredToday = false;
      gameState.bimWingUsedToday = false;
      gameState.todayStats = { revenue: 0, cogs: 0, customersServed: 0, expiredLoss: 0 };
      customers = [];
      activeCustomer = null;

      rollDailyWeather();
      generateDailyWholesalePrices();
      closeModal('modal-eod');
      updateCashierBadge();
      updateAllUI();
      saveGame();
      showToast(`☀️ Selamat pagi Hari ke-${gameState.day}!`, 'success');
    }

    function toggleAudio() {
      const isOn = SoundFX.toggle();
      document.getElementById('btn-audio-toggle').textContent = isOn ? '🔊' : '🔇';
    }

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const colors = {
        success: 'bg-emerald-600 border-emerald-300 text-white',
        error: 'bg-rose-600 border-rose-300 text-white',
        info: 'bg-slate-900/90 border-amber-400 text-amber-100'
      };
      const el = document.createElement('div');
      el.className = `animate-modal pointer-events-auto border-2 rounded-2xl px-3.5 py-2 text-xs font-bold shadow-xl ${colors[type] || colors.info}`;
      el.textContent = msg;
      container.appendChild(el);
      setTimeout(() => {
        el.remove();
      }, 3400);
    }

    function updateHUDClock() {
      const h = Math.floor(gameState.timeMinutes / 60).toString().padStart(2, '0');
      const m = Math.floor(gameState.timeMinutes % 60).toString().padStart(2, '0');
      document.getElementById('hud-clock').textContent = `${h}:${m}`;
    }

    function updateAllUI() {
      document.getElementById('hud-day').textContent = `Hari ke-${gameState.day}`;
      document.getElementById('hud-day-name').textContent = `(${DAYS_OF_WEEK[(gameState.day - 1) % 7]})`;
      document.getElementById('hud-level-badge').textContent = `Warung Josjis ${getWarungLevelInfo().title.split(' ')[0]}`;
      document.getElementById('hud-business-cash').textContent = formatRp(gameState.businessCash);
      document.getElementById('hud-savings-cash').textContent = formatRp(gameState.eduSavings + gameState.walletCash);
      document.getElementById('hud-reputation').textContent = gameState.reputation.toFixed(1);
      document.getElementById('hud-energy-text').textContent = `${gameState.energy}%`;
      document.getElementById('hud-energy-bar').style.width = `${gameState.energy}%`;

      const weatherIcons = { sunny: '☀️', cloudy: '⛅', rainy: '🌧️' };
      document.getElementById('hud-weather-icon').textContent = weatherIcons[gameState.weather] || '☀️';
      updateHUDClock();
    }

    window.addEventListener('resize', resizeCanvas);
    window.onload = function () {
      loadGame();
      resizeCanvas();
      setupHudControls();
      loadCustomHudLayout();
      updateAllUI();
      requestAnimationFrame(gameLoop);
    };
  </script>
