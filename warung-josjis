      if (upgCount >= 3) return { level: 3, title: 'Lv.3 Minimarket Josjis' };
      if (upgCount >= 1) return { level: 2, title: 'Lv.2 Warung Modern' };
      return { level: 1, title: 'Lv.1 Warung Josjis' };
